ARG NGINX_BASE_IMAGE=docker.io/library/nginx:1.30.4-alpine3.24@sha256:dc5069ad14f19660b141b21236140b91656bf89bbc3e2417c70ae650cd66104c
FROM ${NGINX_BASE_IMAGE}

RUN apk upgrade --no-cache \
    && apk add --no-cache 'libexpat>=2.9.0-r0' 'libuuid>=2.42.3-r1' 'libx11>=1.8.14-r0' 'pcre2>=10.49-r0' 'tiff>=4.7.2-r0'
RUN rm -rf /usr/share/nginx/html/*
COPY dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
