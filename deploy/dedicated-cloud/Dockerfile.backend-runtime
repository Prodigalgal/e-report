ARG TEMURIN_BASE_IMAGE=docker.io/library/eclipse-temurin:25-jre-alpine@sha256:3c0a9084927a221ccd1d007fcaf614465672c0af37aaa834c5184483afe56d61
FROM ${TEMURIN_BASE_IMAGE}
ARG ALPINE_REPOSITORY=https://dl-cdn.alpinelinux.org/alpine
RUN sed -i "s#https://dl-cdn.alpinelinux.org/alpine#${ALPINE_REPOSITORY}#g" /etc/apk/repositories
RUN apk upgrade --no-cache \
    && apk add --no-cache 'libexpat>=2.9.0-r0'

WORKDIR /app
COPY app.jar /app/app.jar

EXPOSE 8083
ENV SPRING_PROFILES_ACTIVE=prod

ENTRYPOINT ["java", "-Duser.timezone=UTC", "-jar", "/app/app.jar"]
